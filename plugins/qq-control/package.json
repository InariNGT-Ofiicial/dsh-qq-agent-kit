{
  "name": "dsh-qq-control",
  "version": "0.1.3",
  "type": "module",
  "main": "index.js",
  "description": "QQ 中控：授权群落盘、仅@回复与自主参与开关",
  "files": [
    "index.js",
    "transport.mjs",
    "cordis.patch.yml",
    "README.md",
    "client.js"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    "./client": "./client.js",
    ".": "./index.js"
  }
}
